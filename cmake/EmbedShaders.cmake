# Script mode (cmake -P): writes a .cpp with one uint32_t array per SPIR-V file
# and the table that lib/src/rhi/shaders.h declares.
#
#   -DCAELIX_SHADERS="<name>=<file.spv>|<name>=<file.spv>|..."
#   -DCAELIX_OUTPUT=<file.cpp>

string(REPLACE "|" ";" entries "${CAELIX_SHADERS}")
set(arrays "")
set(table "")
set(count 0)
foreach(entry IN LISTS entries)
  string(FIND "${entry}" "=" split)
  string(SUBSTRING "${entry}" 0 ${split} name)
  math(EXPR path_begin "${split} + 1")
  string(SUBSTRING "${entry}" ${path_begin} -1 path)
  string(MAKE_C_IDENTIFIER "${name}" ident)

  file(READ "${path}" hex HEX)
  string(LENGTH "${hex}" hex_length)
  math(EXPR rest "${hex_length} % 8")
  if(hex_length EQUAL 0 OR NOT rest EQUAL 0)
    message(FATAL_ERROR "${path}: not a SPIR-V word stream (${hex_length} hex digits)")
  endif()
  # Bytes b0 b1 b2 b3 (file order) form the little-endian word 0xb3b2b1b0.
  string(REGEX REPLACE "(..)(..)(..)(..)" "0x\\4\\3\\2\\1u," words "${hex}")
  string(REGEX REPLACE "(0x........u,0x........u,0x........u,0x........u,0x........u,0x........u,0x........u,0x........u,)"
         "\\1\n    " words "${words}")
  string(APPEND arrays "const uint32_t k_${ident}[] = {\n    ${words}\n};\n\n")
  string(APPEND table "    {\"${name}\", k_${ident}, sizeof(k_${ident}) / sizeof(uint32_t)},\n")
  math(EXPR count "${count} + 1")
endforeach()

set(content "// Generated by cmake/EmbedShaders.cmake from the compiled shaders. Do not edit.
#include \"rhi/shaders.h\"

namespace caelix {
namespace {

${arrays}}  // namespace

const EmbeddedShader kEmbeddedShaders[] = {
${table}};
const size_t kEmbeddedShaderCount = ${count};

}  // namespace caelix
")
file(WRITE "${CAELIX_OUTPUT}" "${content}")
